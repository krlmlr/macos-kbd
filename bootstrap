#!/bin/sh

set -e

repo="https://raw.githubusercontent.com/krlmlr/macos-kbd/main"
dest="/Library/Keyboard Layouts"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"

curl -fsS \
  -O "$repo/SwissGermanRussianUbuntu.keylayout" \
  -O "$repo/SwissGermanUbuntu.icns" \
  -O "$repo/SwissGermanUbuntu.keylayout"

sudo mkdir -p "$dest"
sudo install -m 644 "$tmp"/* "$dest"
